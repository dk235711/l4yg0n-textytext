<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="l4yg0n_textytext.Views.AboutWindow"
        Title="About TextyText"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MinWidth="360"
        MaxWidth="360">
    <StackPanel Margin="24" Spacing="12" HorizontalAlignment="Center">
        <TextBlock Text="TextyText 1.0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="TextyText egy L4YG0N altal keszitett Notepad klon"
                   TextWrapping="Wrap"
                   Foreground="#666666"
                   HorizontalAlignment="Center"/>
        <Button Content="OK" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnOk"/>
    </StackPanel>
</Window>
