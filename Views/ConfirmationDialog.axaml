<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="l4yg0n_textytext.Views.ConfirmationDialog"
        Title="Warning"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MinWidth="360">
        <StackPanel Margin="24" Spacing="12">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button x:Name="YesButton" Content="Yes" Click="OnYes" />
                        <Button x:Name="NoButton" Content="No" Click="OnNo" />
                </StackPanel>
        </StackPanel>
</Window>
